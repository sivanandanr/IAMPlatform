{
  "_comment": "IAM broker topology (DL-079). Reviewed and applied by an operator with `rabbitmqctl import_definitions`; module users cannot create, change or delete any of it. Users and passwords are not here: see permissions.json and runbook section 3d.",
  "vhosts": [
    { "name": "iam" }
  ],
  "exchanges": [
    { "name": "iam.unrouted", "vhost": "iam", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "iam.workflow", "vhost": "iam", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": { "alternate-exchange": "iam.unrouted" } },
    { "name": "iam.notification.approval_tasks.dlx", "vhost": "iam", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "iam.notification.approval_tasks.retry", "vhost": "iam", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "iam.notification.approval_tasks.return", "vhost": "iam", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    {
      "name": "iam.unrouted", "vhost": "iam", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "quorum", "x-max-length": 100000, "x-max-length-bytes": 104857600, "x-overflow": "drop-head", "x-message-ttl": 604800000 }
    },
    {
      "name": "iam.notification.approval_tasks", "vhost": "iam", "durable": true, "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 20,
        "x-dead-letter-exchange": "iam.notification.approval_tasks.dlx",
        "x-dead-letter-routing-key": "iam.notification.approval_tasks",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "iam.notification.approval_tasks.dlq", "vhost": "iam", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "iam.notification.approval_tasks.retry", "vhost": "iam", "durable": true, "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 5000,
        "x-dead-letter-exchange": "iam.notification.approval_tasks.return",
        "x-dead-letter-routing-key": "iam.notification.approval_tasks",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    }
  ],
  "bindings": [
    { "source": "iam.unrouted", "vhost": "iam", "destination": "iam.unrouted", "destination_type": "queue", "routing_key": "", "arguments": {} },
    { "source": "iam.workflow", "vhost": "iam", "destination": "iam.notification.approval_tasks", "destination_type": "queue", "routing_key": "workflow.approval.task_opened", "arguments": {} },
    { "source": "iam.notification.approval_tasks.dlx", "vhost": "iam", "destination": "iam.notification.approval_tasks.dlq", "destination_type": "queue", "routing_key": "iam.notification.approval_tasks", "arguments": {} },
    { "source": "iam.notification.approval_tasks.retry", "vhost": "iam", "destination": "iam.notification.approval_tasks.retry", "destination_type": "queue", "routing_key": "iam.notification.approval_tasks", "arguments": {} },
    { "source": "iam.notification.approval_tasks.return", "vhost": "iam", "destination": "iam.notification.approval_tasks", "destination_type": "queue", "routing_key": "iam.notification.approval_tasks", "arguments": {} }
  ]
}
