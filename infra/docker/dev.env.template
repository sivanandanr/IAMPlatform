# Template for the LOCAL DEVELOPMENT .env used by compose.yaml (S1-03). Commit this file; never commit .env.
# Create .env at the repository root with:  scripts/dev-env-init.sh   or   pwsh scripts/dev-env-init.ps1
# Every __GENERATE__ value is replaced with a fresh random secret on your machine only.
# Do not put real, shared or production credentials here.

# --- SQL Server 2022 Developer edition (profile: sqlserver) ---
# Set to Y only if YOU accept the Microsoft SQL Server Developer edition licence (non-production use).
# Left empty, the sqlserver container refuses to start.
MSSQL_ACCEPT_EULA=
MSSQL_SA_PASSWORD=__GENERATE__

# --- PostgreSQL 17 (profile: postgres) ---
POSTGRES_PASSWORD=__GENERATE__

# --- Keycloak local OIDC test provider (ADR-0023) ---
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
IAM_BFF_CLIENT_SECRET=__GENERATE__
IAM_BFF_BASE_URL=https://localhost:5001
# Shared password of the dev.requester / dev.approver / dev.admin test users.
IAM_DEV_USER_PASSWORD=__GENERATE__

# --- Valkey cache ---
VALKEY_PASSWORD=__GENERATE__

# --- RabbitMQ ---
RABBITMQ_USER=iam
RABBITMQ_PASSWORD=__GENERATE__

# --- Telemetry (Aspire dashboard UI login token; collector-to-dashboard API key) ---
ASPIRE_BROWSER_TOKEN=__GENERATE__
ASPIRE_OTLP_API_KEY=__GENERATE__
