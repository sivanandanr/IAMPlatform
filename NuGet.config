<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Single trusted source with source mapping (supply-chain control). Add private feeds only with approval. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
