<Project>
  <!--
    Central package versions. Every package and version here requires approval
    (CLAUDE.md: ask before changing dependency versions or adding paid/licensed packages; Decision Log DL-018).
    Licence recorded from the package nuspec at time of adding.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Authentication and gateway (S1-05, ADR-0012/0013, approved by owner 2026-11-08)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" /> <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />     <!-- MIT -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />                                   <!-- MIT -->
  </ItemGroup>
  <ItemGroup Label="Persistence (S1-06, ADR-0017, approved by owner 2026-11-08)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />   <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />    <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />       <!-- MIT; design-time only (migrations) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />       <!-- PostgreSQL License -->
    <!-- Transitive security pin: Microsoft.Data.SqlClient 6.1.7 pulls Pkcs 9.0.11 (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). MIT. Remove when SqlClient ships a fixed dependency. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Testing (ADR-0022, approved 2026-11-07)">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />  <!-- MIT; approved 2026-11-08 (S1-05) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />                <!-- MIT; approved 2026-11-08 (S1-06) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />           <!-- MIT; approved 2026-11-08 (S1-06) -->
    <!-- Runs on Microsoft.Testing.Platform (global.json "test.runner"); no VSTest adapter packages needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />                        <!-- Apache-2.0 -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />                        <!-- BSD-3-Clause -->
  </ItemGroup>
</Project>
