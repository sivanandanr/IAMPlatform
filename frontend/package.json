{
  "name": "iam",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve iam-portal",
    "build": "ng build iam-ui && ng build iam-portal",
    "build:portal": "ng build iam-portal",
    "test": "ng test iam-ui --watch=false && ng test iam-portal --watch=false",
    "lint": "eslint .",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css,json}\" \"e2e/**/*.ts\" playwright.config.ts eslint.config.mjs \"scripts/*.mjs\"",
    "lint:selftest": "node scripts/lint-selftest.mjs",
    "deps:check": "node scripts/check-dependencies.mjs",
    "e2e": "ng build iam-portal && playwright test",
    "e2e:visual": "ng build iam-portal && node scripts/run-visual.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "ag-grid-angular": "36.3.0",
    "ag-grid-community": "36.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.6",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
