<Project Sdk="Microsoft.NET.Sdk">
  <!-- Provisioning worker (DL-093, ADR-0001): a separate executable with no HTTP surface. It takes approvals' authorisations
       with the provisioning module's own broker user, checks each approval against the audit store (R-037) and plans the
       connector operations. Composes module Infrastructure, never Endpoints. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Local connection strings live in user secrets, never in appsettings (ADR-0017, runbook §3b). -->
    <UserSecretsId>iam-platform-provisioning-worker-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Messaging.RabbitMq\IAM.BuildingBlocks.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Persistence\IAM.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Security\IAM.BuildingBlocks.Security.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.PostgreSql\IAM.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.SqlServer\IAM.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\Connectors\IAM.Connectors.Sdk\IAM.Connectors.Sdk.csproj" />
    <ProjectReference Include="..\..\Modules\Provisioning\IAM.Modules.Provisioning.Application\IAM.Modules.Provisioning.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Provisioning\IAM.Modules.Provisioning.Domain\IAM.Modules.Provisioning.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\Provisioning\IAM.Modules.Provisioning.Infrastructure\IAM.Modules.Provisioning.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Workflow\IAM.Modules.Workflow.Contracts\IAM.Modules.Workflow.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Workflow\IAM.Modules.Workflow.Infrastructure\IAM.Modules.Workflow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Audit\IAM.Modules.Audit.Infrastructure\IAM.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Request\IAM.Modules.Request.Infrastructure\IAM.Modules.Request.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\IAM.Modules.Catalog.Infrastructure\IAM.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Account\IAM.Modules.Account.Infrastructure\IAM.Modules.Account.Infrastructure.csproj" />
  </ItemGroup>
</Project>
