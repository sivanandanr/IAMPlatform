<Project Sdk="Microsoft.NET.Sdk">
  <!-- Request worker (DL-091, ADR-0001): a separate executable with no HTTP surface. It sends the request module's outbox to the
       broker with the request module's own login and broker user, and nothing else. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Local connection strings live in user secrets, never in appsettings (ADR-0017, runbook §3b). -->
    <UserSecretsId>iam-platform-request-worker-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Messaging.RabbitMq\IAM.BuildingBlocks.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Persistence\IAM.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.PostgreSql\IAM.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.SqlServer\IAM.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\Modules\Request\IAM.Modules.Request.Contracts\IAM.Modules.Request.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Request\IAM.Modules.Request.Infrastructure\IAM.Modules.Request.Infrastructure.csproj" />
  </ItemGroup>
</Project>
