<Project Sdk="Microsoft.NET.Sdk">
  <!-- Notification worker (DL-078, ADR-0001): a separate executable with no HTTP surface. Consumes other modules' events
       into the Notification module's inbox with that module's own database login and broker user. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Local connection strings and broker passwords live in user secrets, never in appsettings (ADR-0017, runbook §3d). -->
    <UserSecretsId>iam-platform-notification-worker-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Messaging.RabbitMq\IAM.BuildingBlocks.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IAM.BuildingBlocks.Persistence\IAM.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.PostgreSql\IAM.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\..\Persistence\IAM.Persistence.SqlServer\IAM.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\Modules\Notification\IAM.Modules.Notification.Infrastructure\IAM.Modules.Notification.Infrastructure.csproj" />
  </ItemGroup>
</Project>
