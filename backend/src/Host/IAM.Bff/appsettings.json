{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "",
  "Oidc": {
    "Authority": "",
    "ClientId": "iam-bff",
    "RequireHttpsMetadata": true
  },
  "Session": {
    "IdleTimeout": "00:30:00",
    "AbsoluteTimeout": "10:00:00",
    "MaxSessions": 10000,
    "RefreshBeforeExpiry": "00:00:30"
  },
  "ReverseProxy": {
    "Routes": {
      "iam-api": {
        "ClusterId": "iam-api",
        "AuthorizationPolicy": "bff-session",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "iam-api": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {}
      }
    }
  }
}
